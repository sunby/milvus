+
+class ManifestReadStatsTest : public ::testing::Test {
+  protected:
+  void SetUp() override {
+    root_ = std::filesystem::temp_directory_path() /
+            ("manifest-read-stats-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    std::filesystem::create_directories(root_);
+    fs_ = std::make_shared<arrow::fs::LocalFileSystem>();
+    path_ = get_manifest_filepath((root_ / "segment").string(), 1);
+    ASSERT_TRUE(api::Manifest::WriteTo(fs_, path_, api::Manifest{}).ok());
+    api::Manifest::CleanCache();
+    const char* keys[] = {loon_properties_fs_storage_type, loon_properties_fs_root_path};
+    const auto root = root_.string();
+    const char* values[] = {"local", root.c_str()};
+    auto result = loon_properties_create(keys, values, 2, &properties_);
+    ASSERT_TRUE(loon_ffi_is_success(&result));
+    loon_ffi_free_result(&result);
+  }
+
+  void TearDown() override {
+    loon_properties_free(&properties_);
+    api::Manifest::CleanCache();
+    std::filesystem::remove_all(root_);
+  }
+
+  LoonFFIResult Begin(int64_t version, LoonManifestReadStats* stats) {
+    LoonTransactionHandle handle = 0;
+    auto result = loon_transaction_begin_with_stats("segment", &properties_, version, 0, 1, &handle, stats);
+    if (loon_ffi_is_success(&result)) {
+      EXPECT_NE(handle, 0);
+      loon_transaction_destroy(handle);
+    }
+    return result;
+  }
+
+  std::filesystem::path root_;
+  std::string path_;
+  std::shared_ptr<arrow::fs::FileSystem> fs_;
+  LoonProperties properties_{};
+};
+
+TEST_F(ManifestReadStatsTest, FFIColdThenCachedReadResetsStats) {
+  LoonManifestReadStats stats{};
+  auto result = Begin(1, &stats);
+  ASSERT_TRUE(loon_ffi_is_success(&result)) << loon_ffi_get_errmsg(&result);
+  loon_ffi_free_result(&result);
+  EXPECT_EQ(stats.cache_misses, 1);
+  EXPECT_EQ(stats.cache_hits, 0);
+  EXPECT_GT(stats.filesystem_ns, 0);
+  EXPECT_GT(stats.open_ns, 0);
+  EXPECT_GT(stats.read_ns, 0);
+  EXPECT_GT(stats.deserialize_ns, 0);
+  EXPECT_GT(stats.read_bytes, 0);
+
+  result = Begin(1, &stats);
+  ASSERT_TRUE(loon_ffi_is_success(&result)) << loon_ffi_get_errmsg(&result);
+  loon_ffi_free_result(&result);
+  EXPECT_EQ(stats.cache_hits, 1);
+  EXPECT_EQ(stats.cache_misses, 0);
+  EXPECT_EQ(stats.open_ns, 0);
+  EXPECT_EQ(stats.read_ns, 0);
+  EXPECT_EQ(stats.deserialize_ns, 0);
+  EXPECT_EQ(stats.read_bytes, 0);
+  EXPECT_EQ(stats.s3_retries, 0);
+}
+
+TEST_F(ManifestReadStatsTest, FFIFailureIncludesPartialTiming) {
+  LoonManifestReadStats stats{};
+  auto result = Begin(2, &stats);
+  EXPECT_FALSE(loon_ffi_is_success(&result));
+  loon_ffi_free_result(&result);
+  EXPECT_EQ(stats.cache_misses, 1);
+  EXPECT_GT(stats.open_ns, 0);
+  EXPECT_EQ(stats.read_ns, 0);
+
+  std::ofstream(path_, std::ios::binary | std::ios::trunc) << "invalid manifest";
+  result = Begin(1, &stats);
+  EXPECT_FALSE(loon_ffi_is_success(&result));
+  loon_ffi_free_result(&result);
+  EXPECT_EQ(stats.cache_misses, 1);
+  EXPECT_GT(stats.read_bytes, 0);
+  EXPECT_GT(stats.deserialize_ns, 0);
+  EXPECT_EQ(stats.cache_insert_ns, 0);
+
+  stats.cache_hits = 99;
+  LoonTransactionHandle handle = 0;
+  result = loon_transaction_begin_with_stats(nullptr, &properties_, 1, 0, 1, &handle, &stats);
+  EXPECT_FALSE(loon_ffi_is_success(&result));
+  loon_ffi_free_result(&result);
+  EXPECT_EQ(stats.cache_hits, 0);
+  EXPECT_EQ(stats.filesystem_ns, 0);
+}
+
+TEST(ManifestReadStats, RetryPolicyCounts503IncludingExhaustedRetry) {
+  LoonManifestReadStats stats{};
+  ManifestReadScope scope(&stats);
+  fs::internal::ConnectRetryStrategy strategy;
+  Aws::Client::AWSError<Aws::Client::CoreErrors> error(Aws::Client::CoreErrors::SERVICE_UNAVAILABLE, true);
+  error.SetResponseCode(Aws::Http::HttpResponseCode::SERVICE_UNAVAILABLE);
+  EXPECT_TRUE(strategy.ShouldRetry(error, 0));
+  EXPECT_EQ(strategy.CalculateDelayBeforeNextRetry(error, 0), 200);
+  EXPECT_FALSE(strategy.ShouldRetry(error, 30));
+  Aws::Client::AWSError<Aws::Client::CoreErrors> denied(Aws::Client::CoreErrors::ACCESS_DENIED, false);
+  denied.SetResponseCode(Aws::Http::HttpResponseCode::FORBIDDEN);
+  EXPECT_FALSE(strategy.ShouldRetry(denied, 0));
+  EXPECT_EQ(stats.s3_503s, 2);
+  EXPECT_EQ(stats.s3_retries, 1);
+  EXPECT_EQ(stats.retry_delay_requested_ns, 200000000);
+}
+
+TEST(ManifestReadStats, NestedScopesAndConcurrentThreadsAreIsolated) {
+  LoonManifestReadStats outer{}, inner{};
+  {
+    ManifestReadScope scope(&outer);
+    RecordManifestRetryDecision(503, true);
+    {
+      ManifestReadScope nested(&inner);
+      RecordManifestRetryDelay(7);
+    }
+    std::vector<std::thread> threads;
+    std::vector<LoonManifestReadStats> per_thread(8);
+    for (auto& stats : per_thread) {
+      threads.emplace_back([&stats] {
+        ManifestReadScope scope(&stats);
+        for (int i = 0; i < 100; ++i) {
+          RecordManifestRetryDecision(503, true);
+        }
+      });
+    }
+    for (auto& thread : threads) {
+      thread.join();
+    }
+    for (const auto& stats : per_thread) {
+      EXPECT_EQ(stats.s3_503s, 100);
+    }
+    RecordManifestRetryDecision(503, false);
+  }
+  RecordManifestRetryDecision(503, true);
+  EXPECT_EQ(outer.s3_503s, 2);
+  EXPECT_EQ(outer.s3_retries, 1);
