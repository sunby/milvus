+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "milvus-storage/common/manifest_read_stats.h"
+
+namespace milvus_storage {
+namespace {
+thread_local LoonManifestReadStats* current_stats = nullptr;
+}
+
+ManifestReadScope::ManifestReadScope(LoonManifestReadStats* stats) : previous_(current_stats) {
+  if (stats != nullptr) {
+    *stats = {};
+  }
+  current_stats = stats;
+}
+
+ManifestReadScope::~ManifestReadScope() { current_stats = previous_; }
+
+ManifestReadTimer::ManifestReadTimer(uint64_t LoonManifestReadStats::*field)
+    : value_(current_stats == nullptr ? nullptr : &(current_stats->*field)) {
+  if (value_ != nullptr) {
+    started_ = std::chrono::steady_clock::now();
+  }
+}
+
+ManifestReadTimer::~ManifestReadTimer() { End(); }
+
+void ManifestReadTimer::End() {
+  if (value_ != nullptr) {
+    *value_ +=
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - started_).count();
+    value_ = nullptr;
+  }
+}
+
+void AddManifestReadStat(uint64_t LoonManifestReadStats::*field, uint64_t value) {
+  if (current_stats != nullptr) {
+    current_stats->*field += value;
+  }
+}
+
+void RecordManifestRetryDecision(int http_status, bool retry) {
+  AddManifestReadStat(&LoonManifestReadStats::s3_503s, http_status == 503 ? 1 : 0);
+  AddManifestReadStat(&LoonManifestReadStats::s3_retries, retry ? 1 : 0);
+}
+
+void RecordManifestRetryDelay(long delay_ms) {  // NOLINT runtime/int
+  if (delay_ms > 0) {
+    AddManifestReadStat(&LoonManifestReadStats::retry_delay_requested_ns, static_cast<uint64_t>(delay_ms) * 1000000);
+  }
+}
+}  // namespace milvus_storage
