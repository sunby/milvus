+#pragma once
+
+#include <chrono>
+#include "milvus-storage/ffi_c.h"
+
+namespace milvus_storage {
+
+// Synchronous transaction reads and their AWS SDK retry callbacks run on the
+// caller thread. Scope state is isolated per thread and restored on nested exit.
+class ManifestReadScope {
+  public:
+  explicit ManifestReadScope(LoonManifestReadStats* stats);
+  ~ManifestReadScope();
+  ManifestReadScope(const ManifestReadScope&) = delete;
+  ManifestReadScope& operator=(const ManifestReadScope&) = delete;
+
+  private:
+  LoonManifestReadStats* previous_;
+};
+
+class ManifestReadTimer {
+  public:
+  explicit ManifestReadTimer(uint64_t LoonManifestReadStats::*field);
+  ~ManifestReadTimer();
+  ManifestReadTimer(const ManifestReadTimer&) = delete;
+  ManifestReadTimer& operator=(const ManifestReadTimer&) = delete;
+  void End();
+
+  private:
+  uint64_t* value_;
+  std::chrono::steady_clock::time_point started_;
+};
+
+void AddManifestReadStat(uint64_t LoonManifestReadStats::*field, uint64_t value = 1);
+void RecordManifestRetryDecision(int http_status, bool retry);
+void RecordManifestRetryDelay(long delay_ms);  // NOLINT runtime/int
+
+}  // namespace milvus_storage
